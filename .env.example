# WeChat Official Account configuration
WX_APP_ID=wx_your_app_id_here
WX_APP_SECRET=your_app_secret_here

# Relay server
PORT=3900
HOST=0.0.0.0

# Required. Generate with: openssl rand -hex 32
API_KEY=change_me_to_a_random_string

# Optional rate limit per IP per minute. Set 0 to disable.
RATE_LIMIT_RPM=60

# Optional token cache. The server writes this file with mode 0600.
TOKEN_CACHE_FILE=/tmp/wxofficial-relay-token.json

# Optional upload limit. Examples: 5mb, 10mb.
MAX_IMAGE_SIZE=10mb

# Generic WeChat API proxy is disabled by default. Enable only when needed.
ENABLE_GENERIC_PROXY=0

# Optional HTTPS certificate. Prefer Caddy or Nginx in production.
# TLS_CERT=/etc/letsencrypt/live/wx.example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/wx.example.com/privkey.pem

# ===== 微信公众号配置（必填）=====
# 在公众号后台 → 设置与开发 → 基本配置 获取
WX_APP_ID=wx_your_app_id_here
WX_APP_SECRET=your_app_secret_here

# ===== 代理服务配置 =====
# 监听端口
PORT=3900
# 监听地址（0.0.0.0 表示接受所有来源，建议配合防火墙使用）
HOST=0.0.0.0

# ===== 安全配置 =====
# API Key：客户端调用时需要携带此密钥（Header: X-Api-Key）
# 生成方式: openssl rand -hex 32
API_KEY=change_me_to_a_random_string

# ===== 速率限制（可选）=====
# 每 IP 每分钟最大请求数，注释掉则不限制
RATE_LIMIT_RPM=60

# ===== Token 持久化（可选）=====
# 如果设置，access_token 会保存到磁盘，重启后复用（避免每次重启都调 token 接口）
# TOKEN_CACHE_FILE=/tmp/wx-proxy-token.json

# ===== HTTPS 证书（推荐）=====
# 配置后自动启用 HTTPS（端口为 PORT+1，如 3901）
# 生成自签证书: openssl req -x509 -nodes -days 3650 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -keyout cert.key -out cert.crt -subj "/CN=你的服务器IP" -addext "subjectAltName=IP:你的服务器IP"
TLS_CERT=/etc/caddy/certs/wx-proxy.crt
TLS_KEY=/etc/caddy/certs/wx-proxy.key
